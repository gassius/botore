{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "design-review": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DESIGN_CAPTURE": "1",
        "EXPO_PUBLIC_DESIGN_CAPTURE_POSE_COMPARE": "1",
        "EXPO_PUBLIC_ALLOW_DEV_SCAFFOLD": "1",
        "EXPO_PUBLIC_CRASH_REPORTING": "0",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "ios": {
        "simulator": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ALLOW_DEV_SCAFFOLD": "1",
        "EXPO_PUBLIC_CRASH_REPORTING": "0",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CRASH_REPORTING": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "release-perf": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PERF_SAMPLE": "1"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_CRASH_REPORTING": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
