# Public Supabase Auth + PostgREST for F8 garage scaffolding.
# Never put service_role keys here — anon key only. RLS + save_bot_loadout enforce writes.
#
# When unset, the app uses DEV auth/loadout adapters (local scaffolding).

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# R3 crash reporting (Sentry). Leave unset for local `pnpm start` — no cloud
# account required. Preview/production EAS profiles set EXPO_PUBLIC_CRASH_REPORTING=1;
# bake the DSN via EAS env/secret (never commit a real DSN to git if policy forbids).
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# EXPO_PUBLIC_CRASH_REPORTING=0
# Internal proof only (never store builds): EXPO_PUBLIC_CRASH_REPORTING_FORCE_TEST=1
#
# EAS / CI secrets for source maps (not EXPO_PUBLIC):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=REPLACE_SENTRY_ORG
# SENTRY_PROJECT=REPLACE_SENTRY_PROJECT
# Default EAS profiles set SENTRY_DISABLE_AUTO_UPLOAD=true so builds without
# those secrets succeed. Remove/disable that flag on preview/production only
# after the token + org are provisioned (see docs/architecture/crash-reporting.md).
