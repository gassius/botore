{
  "expo": {
    "name": "Botore",
    "slug": "botore-game",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "botore",
    "icon": "./assets/launch-v001/icon/icon-ios-1024.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.botore.game",
      "icon": "./assets/launch-v001/icon/icon-ios-1024.png"
    },
    "android": {
      "package": "com.botore.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/launch-v001/icon/adaptive-foreground-1024.png",
        "backgroundImage": "./assets/launch-v001/icon/adaptive-background-1024.png",
        "backgroundColor": "#F4B820",
        "monochromeImage": "./assets/launch-v001/icon/adaptive-monochrome-1024.png"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/ui-kit-v0.1/brand/robot-head-small.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#302D27",
          "image": "./assets/launch-v001/splash/splash-logo-1284.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "ios": {
            "backgroundColor": "#302D27",
            "image": "./assets/launch-v001/splash/splash-logo-1284.png",
            "imageWidth": 280,
            "resizeMode": "contain"
          },
          "android": {
            "backgroundColor": "#302D27",
            "image": "./assets/launch-v001/splash/splash-icon-android-1024.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "REPLACE_SENTRY_ORG",
          "project": "REPLACE_SENTRY_PROJECT"
        }
      ],
      "expo-secure-store"
    ]
  }
}
