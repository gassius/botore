{
  "name": "botore",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "env:up": "bash infra/env-up.sh",
    "env:down": "bash infra/env-down.sh",
    "db:reset": "bash infra/db-reset.sh",
    "test:smoke": "node scripts/backend-smoke.mjs",
    "test:coverage:backend": "pnpm exec turbo run build --filter=@botore/domain --filter=@botore/rng --filter=@botore/replay --filter=@botore/contracts --filter=@botore/combat-engine && pnpm --filter @botore/domain exec vitest run --coverage && pnpm --filter @botore/contracts exec vitest run --coverage && pnpm --filter @botore/combat-engine exec vitest run --coverage && pnpm --filter @botore/replay exec vitest run --coverage && pnpm --filter @botore/rng exec vitest run --coverage && node scripts/edge-coverage-gate.mjs",
    "test:coverage:edge": "node scripts/edge-coverage-gate.mjs",
    "test:coverage:db": "node scripts/db-test-coverage-gate.mjs",
    "vendor:edge-combat": "node scripts/vendor-edge-combat.mjs",
    "test:edge-runtime": "node scripts/edge-combat-runtime-check.mjs",
    "test:smoke-combat-assert": "node --test scripts/smoke-combat-assert.test.mjs",
    "verify": "bash infra/verify.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.0",
    "prettier": "^3.7.4",
    "supabase": "^2.115.0",
    "tsx": "^4.20.6",
    "turbo": "^2.10.11",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
