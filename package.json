{
  "name": "botore",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "env:up": "bash infra/env-up.sh",
    "env:down": "bash infra/env-down.sh",
    "db:reset": "bash infra/db-reset.sh",
    "verify": "bash infra/verify.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "eslint": "^9.39.0",
    "prettier": "^3.7.4",
    "supabase": "^2.115.0",
    "tsx": "^4.20.6",
    "turbo": "^2.10.11",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
